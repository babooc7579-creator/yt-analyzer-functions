{
  "version": 1,
  "projectId": "yt-analyzer",
  "projectName": "타임머신 CRM / Creator OS",
  "repository": "babooc7579-creator/yt-analyzer-functions",
  "repositoryRole": "azure-functions-backend",
  "owner": "Kaion IT",
  "environment": ["development", "production"],
  "criticality": "internal-production",
  "resourceRegisterId": "kaion-central-resource-register",
  "activeResourceIds": [
    "azure-sponsorship",
    "github-account",
    "azure-yt-analyzer-function",
    "azure-yt-analyzer-cosmos",
    "youtube-data-api"
  ],
  "optionalResourceIds": [
    "chatgpt-subscription",
    "openai-api"
  ],
  "excludedScopes": [
    "kaion-homepage",
    "service-hub",
    "personal-monetization"
  ],
  "changePolicy": {
    "readRegisterBeforePaidChange": true,
    "recordResourceAndHistoryTogether": true,
    "requireApprovalForPurchaseOrCancellation": true,
    "paidApiDefault": "manual-one-channel-up-to-100-no-repeat",
    "distinguishDatabaseReadFromApiCollection": true,
    "preserveSeparateBackfillState": true,
    "neverRecordSecrets": true
  },
  "aiUsagePolicy": {
    "status": "planned-disabled-until-approved",
    "approvedUseCases": [
      "사용자가 선택한 저장 후보의 제목·구성·대본·설명 초안 생성"
    ],
    "apiPilotConstraints": {
      "explicitUserAction": true,
      "singleCandidateDefault": true,
      "automaticRepeat": false,
      "humanReviewRequired": true,
      "separateFromYouTubeCollection": true,
      "recordUsageAndEstimatedCost": true
    }
  }
}
